# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Scratch files: a leading underscore means "not part of the project".
/_*.py
/_*.txt
/_*.mjs
/_*.log
/_*.json

# Runtime state, if a deployment points the alert webhook at a file.
_florina_state*.json

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Research downloads. The scripts kept here fetch what they need and cache it
# in research/_cache/, which is local only. Everything else that lands in this
# directory - PDFs, scraped HTML, station dumps, shapefiles - is source
# material, not part of the project. 91 MB of it was committed once by a
# 'git add -A'; this rule is why it will not be again.
research/*
!research/*.py
research/_cache/
